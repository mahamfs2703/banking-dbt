create or replace transient table DB_BANKING.MARTS.dim_customer
         as
        (with versions as (

    select
        *,
        row_number() over (partition by customer_id order by dbt_valid_from) as version_number
    from DB_BANKING.SNAPSHOTS.snap_customers
    
)

select

    md5(cast(customer_id as varchar) || '|' || cast(dbt_valid_from as varchar)) as customer_key,
    customer_id,
    first_name,
    last_name,
    email,
    phone,
    city,
    country,
    kyc_status,
    created_at,
    case
        when version_number = 1 then to_timestamp_tz('1900-01-01 00:00:00')
        else dbt_valid_from
    end as valid_from,
    dbt_valid_to as valid_to,
    dbt_valid_to = to_timestamp_tz('9999-12-31 00:00:00') as is_current
    
from versions
        );
